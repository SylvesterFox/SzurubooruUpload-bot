# Получить у @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram ID пользователей, которым разрешена загрузка (обязательное поле)
TELEGRAM_ALLOWED_USERS=

# Адрес Szurubooru с машины/контейнера, где запускается бот
SZURU_URL=http://127.0.0.1:8080
SZURU_API_PREFIX=/api
SZURU_USERNAME=
# Используйте токен пользователя Szurubooru, предпочтительно отдельный токен
SZURU_TOKEN=
# Вместо токена можно задать пароль:
# SZURU_PASSWORD=

DEFAULT_SAFETY=unsafe
MAX_FILE_MB=200
MAX_LINK_FILES=10

# API key for reverse image search; matching e621 tags are added when found
FUZZYSEARCH_API_KEY=
FUZZYSEARCH_URL=https://api.fuzzysearch.net/v1
E621_USER_AGENT=szurubooru-telegram-uploader/1.0 (contact: your-email@example.com)

# Сайты, требующие авторизации в gallery-dl (задайте один вариант)
# Netscape-format cookies.txt exported from your browser
GALLERY_DL_COOKIES_FILE=
# Or browser profile, e.g. firefox or chrome
GALLERY_DL_COOKIES_FROM_BROWSER=
